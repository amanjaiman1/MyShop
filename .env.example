# ---------------------------------------------------------------------------
# Aurelia environment
# Copy to `.env.local` and fill in. NEVER commit `.env.local`.
# ---------------------------------------------------------------------------

# Supabase project URL — Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable / anon key. Safe for the browser: every table is protected by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Canonical site URL. Used to build Supabase Auth redirect links
# (password reset). In production set this to your Vercel domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# SERVER-ONLY — never prefix with NEXT_PUBLIC_, never expose to the browser.
# Only required for the one-off owner bootstrap and the demo seed script.
# Do not set this in the Vercel project unless you need those scripts there.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Owner account created/used by `npm run seed:demo`
DEMO_OWNER_EMAIL=owner@aurelia.shop
DEMO_OWNER_PASSWORD=change-this-strong-password
