# ── Supabase ────────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in your project's values.
# Find both under: Supabase Dashboard → Project Settings → API.
#
# These are PUBLIC values (safe to expose in the browser). Your data is
# protected by Row Level Security, not by hiding the anon key.
#
# On Vercel, add these same two variables under
# Project Settings → Environment Variables (Production + Preview + Development),
# then redeploy. The `NEXT_PUBLIC_` prefix is required — the browser cannot
# read server-only variables.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key


# ── Optional ────────────────────────────────────────────────────────
# Canonical site URL, used to build password-reset links. If unset, Aurelia
# falls back to the Vercel deployment URL, so you usually don't need this.
# NEXT_PUBLIC_SITE_URL=https://your-shop.vercel.app


# ── Optional: demo data only ────────────────────────────────────────
# You do NOT need these to run the app. The sign-in screen lets you create
# your owner account on first visit.
#
# Set them only if you want to run `npm run seed:demo`, which fills the shop
# with realistic sample products, purchases, sales and expenses.
# SUPABASE_SERVICE_ROLE_KEY is a SECRET — never commit it, and never add it
# to a browser-exposed variable.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# DEMO_OWNER_EMAIL=owner@yourshop.com
# DEMO_OWNER_PASSWORD=choose-a-strong-password
